<entity name="svn.relativepath"><note>
 <simpara>Relative paths will be resolved as if the current working directory
 was the one that contains the PHP binary. To use the calling script's working
 directory, use <function>realpath</function> or dirname(__FILE__).</simpara>
</note></entity>

</entities>
