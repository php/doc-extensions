<refentry xml:id="solrparams.tostring" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SolrParams::toString</refname>
  <refpurpose>Returns all the name-value pair parameters in the object</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>final</modifier> <modifier>public</modifier> <type>string</type><methodname>SolrParams::toString</methodname>
   <methodparam choice="opt"><type>bool</type><parameter>url_encode</parameter><initializer>&false;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Returns all the name-value pair parameters in the object
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>url_encode</parameter></term>
     <listitem>
      <simpara>
       Whether to return URL-encoded values
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
 Returns a string on success and &false; on failure.
  </simpara>
 </refsect1>


</refentry>

