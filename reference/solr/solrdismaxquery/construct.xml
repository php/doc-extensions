<refentry xml:id="solrdismaxquery.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SolrDisMaxQuery::__construct</refname>
  <refpurpose>Class Constructor</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis>
   <modifier>public</modifier> <methodname>SolrDisMaxQuery::__construct</methodname>
   <methodparam choice="opt"><type>string</type><parameter>q</parameter></methodparam>
  </constructorsynopsis>
  <simpara>
    Class constructor initializes the object and sets the q parameter if passed
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>q</parameter></term>
    <listitem>
     <simpara>
      Search Query (q parameter)
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>

  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Emits <exceptionname>SolrIllegalArgumentException</exceptionname> in case of an invalid parameter was passed.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>SolrDisMaxQuery::__construct</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php

$dismaxQuery = new SolrDisMaxQuery('lucene');
echo $dismaxQuery;

?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
q=lucene&defType=edismax
]]>
   </screen>
  </example>
 </refsect1>

</refentry>
