<refentry xml:id="ui-menu.appendabout" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>UI\Menu::appendAbout</refname>
  <refpurpose>Append About Menu Item</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>UI\MenuItem</type><methodname>UI\Menu::appendAbout</methodname>
   <methodparam choice="opt"><type>string</type><parameter>type</parameter><initializer>UI\MenuItem::class</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Shall append an About menu item
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>type</parameter></term>
    <listitem>
     <simpara>
      The type for the new item
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   A constructed About menu item of the given type
  </simpara>
 </refsect1>


</refentry>

