 PECL extensions</link></entity>

<entity name="link.install.windows.building"><link
 xlink:href="https://www.php.net/manual/en/install.windows.building.php">building
 on Windows</link></entity>

<entity name="link.book.libxml"><link
 xlink:href="https://www.php.net/manual/en/book.libxml.php">libxml</link></entity>

<entity name="link.ref.mcrypt"><link
 xlink:href="https://www.php.net/manual/en/ref.mcrypt.php">mcrypt</link></entity>

<entity name="link.ref.mhash"><link
