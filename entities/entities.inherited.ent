     <modifier>public</modifier> <type>bool</type><methodname xlink:href="&url.php.manual.arrayaccess.offsetexists;">ArrayAccess::offsetExists</methodname>
     <methodparam><type>mixed</type><parameter>offset</parameter></methodparam>
    </methodsynopsis>
    <methodsynopsis role="ArrayAccess">
     <modifier>public</modifier> <type>mixed</type><methodname xlink:href="&url.php.manual.arrayaccess.offsetget;">ArrayAccess::offsetGet</methodname>
     <methodparam><type>mixed</type><parameter>offset</parameter></methodparam>
